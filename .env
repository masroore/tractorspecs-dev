# Sample environment for local development — copy to .env and edit values

# Webshare (optional) — leave empty to disable proxy rotation
WEBSHARE_API_KEY=6em3b19hgip8qygiu4209yey4lthz7ije8dj2tf2

# Postgres DSN used by asyncpg
# Use the docker-compose service name `db` when running with docker-compose
POSTGRES_PORT=5454
POSTGRES_USER=scraper
POSTGRES_PASSWORD=password
POSTGRES_DB=tractors
POSTGRES_HOST=db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# MinIO / S3 settings
MINIO_PORT=8989
MINIO_ADMIN_PORT=8990
MINIO_ENDPOINT=http://minio:${MINIO_PORT}
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=secret123
MINIO_BUCKET=tractor-snapshots
# Optional S3 region
S3_REGION=us-east-1

# Base site to crawl (used by seed logic)
TARGET_BASE_URL=https://www.tractordata.com

# Concurrency & rate limiting
MAX_CONCURRENCY=5
RATE_LIMIT_RPS=5

# Snapshot retention (days)
SNAPSHOT_TTL_DAYS=30

# Logging
LOG_LEVEL=INFO

# Toggle proxy usage (true/false)
ENABLE_PROXIES=true
