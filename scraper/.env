# Sample environment for local development — copy to .env and edit values

# Webshare (optional) — leave empty to disable proxy rotation
WEBSHARE_API_KEY=http://qxerhmfs:odvgwubmbjti@31.59.20.176:6754/

# Postgres DSN used by asyncpg
# Use the docker-compose service name `db` when running with docker-compose
DATABASE_URL=postgresql://scraper:scraperpass@db:5432/tractors?sslmode=disable

# MinIO / S3 settings
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tractor-snapshots
# Optional S3 region
S3_REGION=us-east-1

# Base site to crawl (used by seed logic)
TARGET_BASE_URL=https://example-tractor-site.local

# Concurrency & rate limiting
MAX_CONCURRENCY=10
RATE_LIMIT_RPS=5

# Snapshot retention (days)
SNAPSHOT_TTL_DAYS=30

# Logging
LOG_LEVEL=INFO

# Toggle proxy usage (true/false)
ENABLE_PROXIES=true
